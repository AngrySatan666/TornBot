{
    "name": "TornBot",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12.10"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "18"
        }
    },
    "postCreateCommand": "pip install virtualenv matplotlib pandas numpy requests sqlalchemy",
    "forwardPorts": [5000, 3000],
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode-remote.remote-wsl",
                "alexcvzz.vscode-sqlite",
                "ms-vscode.cpptools",
                "ms-vsliveshare.vsliveshare",
                "ms-vscode.powershell",
                "yzhang.markdown-all-in-one",
                "qwtel.sqlite-viewer",
                "mtxr.sqltools",
                "ms-toolsai.tensorboard",
                "donjayamanne.githistory",
                "rogwilco.defaults-vscode-markdown",
                "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
                "bierner.markdown-shiki",
                "ms-python.debugpy",
                "github.codespaces",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cmake-tools",
                "bierner.markdown-preview-github-styles",
                "bierner.markdown-mermaid",
                "bierner.markdown-emoji",
                "bierner.github-markdown-preview",
                "bierner.markdown-footnotes",
                "bierner.markdown-checkbox",
                "bierner.markdown-yaml-preamble",
                "alefragnani.bookmarks",
                "mccarter.start-git-bash",
                "george-alisson.html-preview-vscode",
                "sidthesloth.html5-boilerplate",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.vscode-jupyter-slideshow",
                "ms-toolsai.jupyter-renderers",
                "ms-vscode.vscode-websearchforcopilot",
                "ms-vscode.makefile-tools",
                "golang.go",
                "ms-python.python",
                "github.vscode-github-actions",
                "llvm-vs-code-extensions.vscode-clangd",
                "zignd.html-css-class-completion",
                "aessoft.aessoft-class-autocomplete",
                "kodu-ai.claude-dev-experimental",
                "ms-toolsai.datawrangler",
                "ms-toolsai.jupyter",
                "davidanson.vscode-markdownlint",
                "ms-vscode-remote.remote-containers",
                "specstory.specstory-vscode",
                "hyperoot.settings-organizer",
                "dbaeumer.vscode-eslint",
                "ms-vscode.remote-explorer",
                "ms-vscode-remote.remote-ssh-edit",
                "ms-vscode-remote.remote-ssh",
                "mhutchie.git-graph",
                "formulahendry.auto-close-tag",
                "esbenp.prettier-vscode",
                "formulahendry.auto-rename-tag",
                "angelmaneuver.wallpaper-setting",
                "liriliri.vscode-settings-editor",
                "ragavks.recommended-settings",
                "streetsidesoftware.code-spell-checker",
                "ms-vscode.hexeditor",
                "redhat.vscode-yaml",
                "visualstudioexptteam.intellicode-api-usage-examples",
                "visualstudioexptteam.vscodeintellicode",
                "rogalmic.bash-debug",
                "shardulm94.trailing-spaces",
                "ms-vscode.test-adapter-converter",
                "ritwickdey.liveserver",
                "ms-vscode.live-server",
                "ms-vscode.wordcount",
                "njpwerner.autodocstring",
                "hbenl.vscode-test-explorer",
                "littlefoxteam.vscode-python-test-adapter",
                "tamasfe.even-better-toml",
                "henriiik.docker-linter",
                "076923.python-image-preview",
                "kaih2o.python-resource-monitor",
                "benspaulding.python-manifest-template",
                "ms-python.isort",
                "ms-azuretools.vscode-docker",
                "ms-azuretools.vscode-containers",
                "ms-ossdata.vscode-pgsql",
                "nilssoderman.ue-python",
                "ms-vscode.js-debug-nightly",
                "ms-python.vscode-python-envs",
                "ms-vscode.vscode-typescript-next"
            ],
            "settings": {
              // _WORKBENCH \\
                "workbench.colorTheme": "Default Dark Modern",
                "breadcrumbs.enabled": true,
                "breadcrumbs.showProperties": true,
                "workbench.cloudChanges.autoResume": "onReload",
                "workbench.editor.showIcons": true,
                "workbench.editor.showTabs": "multiple",
                "workbench.editor.tabSizingFixedMaxWidth": 80,
                "workbench.editor.tabSizingFixedMinWidth": 40,
                "workbench.settings.editor": "json",
                "workbench.settings.openDefaultSettings": true,
                "workbench.secondarySideBar.showLabels": true,
                "workbench.sideBar.location": "left",
                "workbench.settings.showSuggestions": true,
                "workbench.tree.stickyScrollMaxItemCount": 8,
                "workbench.statusBar.visible": true,

              // _EDITOR \\
                "editor.renderWhitespace": "all",
                "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
                "editor.minimap.renderCharacters": true,
                "editor.guides.bracketPairs": true,
                "diffEditor.codeLens": true,
                "editor.inlineSuggest.showToolbar": "onHover",
                "editor.quickSuggestionsDelay": 1,
                "editor.screenReaderAnnounceInlineSuggestion": false,
                "editor.stickyScroll.enabled": true,
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "terminal.integrated.shellIntegration.decorationsEnabled": "both",
                "editor.detectIndentation": false,
                "editor.showUnused": true,
                "editor.autoClosingBrackets": "languageDefined",
                "editor.bracketPairColorization.enabled": true,
                "editor.fontSize": 14,
                "editor.fontFamily": "Arial Unicode MS, Consolas, 'Courier New', monospace",

              // _FILES \\
                "files.autoSave": "onFocusChange",
                "files.associations": {
                    "copyright": "plaintext"
                },
                "files.exclude": {
                    "**/.DS_Store": false,
                    "**/.git": false,
                    "**/.hg": false,
                    "**/.svn": false,
                    "**/Thumbs.db": false,
                    "desktop.ini": true
                },
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "files.trimTrailingWhitespaceInRegexAndStrings": true,
                "files.enableTrash": true,

              // _EXPLORER \\
                "explorer.fileNesting.patterns": {
                    "*.bat": "${capture}.bat.*",
                    "*.c": "${capture}.h, ${capture}.o, ${capture}.obj",
                    "*.cpp": "${capture}.h, ${capture}.hpp, ${capture}.o, ${capture}.obj",
                    "*.css": "${capture}.scss, ${capture}.sass, ${capture}.less, ${capture}.css.map",
                    "*.db": "${capture}.${extname}-*",
                    "*.db3": "${capture}.${extname}-*",
                    "*.env": "${capture}.env.*",
                    "*.go": "${capture}_test.go",
                    "*.h": "${capture}.c, ${capture}.cpp",
                    "*.html": "${capture}.spec.ts, ${capture}.test.ts, ${capture}.test.js, ${capture}.spec.js",
                    "*.ipynb": "${capture}.ipynb-checkpoint",
                    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
                    "*.json": "${capture}.schema.json",
                    "*.jsx": "${capture}.js",
                    "*.less": "${capture}.css, ${capture}.css.map",
                    "*.md": "${capture}.mdx",
                    "*.php": "${capture}.blade.php",
                    "*.py": "${capture}.pyc, ${capture}.pyo, ${capture}.pyd",
                    "*.rs": "${capture}_test.rs",
                    "*.s3db": "${capture}.${extname}-*",
                    "*.sdb": "${capture}.${extname}-*",
                    "*.scss": "${capture}.css, ${capture}.css.map",
                    "*.sh": "${capture}.sh.*",
                    "*.sqlite": "${capture}.${extname}-*",
                    "*.sqlite3": "${capture}.${extname}-*",
                    "*.tsx": "${capture}.ts",
                    "*.ts": "${capture}.js",
                    "*.vue": "${capture}.css, ${capture}.scss, ${capture}.spec.js, ${capture}.test.js",
                    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
                    "tsconfig.json": "tsconfig.*.json"
                },
                "explorer.confirmDelete": false,
                "explorer.confirmDragAndDrop": false,
                "explorer.fileNesting.enabled": true,

              // _TERMINAL \\
                "terminal.integrated.hideOnStartup": "never",
                "terminal.integrated.bellDuration": 1000,
                "terminal.integrated.allowChords": true,
                "terminal.integrated.defaultLocation": "view",
                "terminal.integrated.enableFileLinks": "on",

                // @ OS --Windows
                "terminal.integrated.defaultProfile.windows": "Command Prompt",
                "terminal.integrated.profiles.windows": {
                    "Git Bash": {
                        "path": "C:\\Program Files\\Git\\bin\\bash.exe"
                    },
                    "Git CLI": {
                        "path": "C:\\Program Files\\Git\\cmd\\git.exe"
                    },
                    "Command Prompt": {
                        "path": "C:\\Windows\\System32\\cmd.exe"
                    },
                    "PowerShell": {
                        "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
                    },
                    "Python": {
                        "path": "C:\\Users\\angry\\AppData\\Local\\Programs\\Python\\Python310\\python.exe"
                    },
                    "Java": {
                        "path": "C:\\Program Files\\Java\\jdk-21.0.2\\bin\\java.exe"
                    },
                    "Go" : {
                        "path": "C:\\Users\\angry\\go\\bin\\gopls.exe"
                    },
                    "ADB": {
                        "path": "C:\\Users\\angry\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe"
                    },
                    "Node.js": {
                        "path": "C:\\Program Files\\nodejs\\node.exe"
                    },
                    "NGROK": {
                        "path": "C:\\Users\\angry\\ngrok\\ngrok.exe"
                    },
                    "Cloudflared": {
                        "path": "C:\\Users\\angry\\cloudflared\\cloudflared.exe"
                    }
                },

                "terminal.integrated.env.windows": {
                    "Git Bash_Dir": "C:\\Program Files\\Git\\bin\\bash.exe",
                    "Git Bash_EXE": "C:\\Program Files\\Git\\bin\\bash.exe",
                    "Command Prompt_Dir": "C:\\Windows\\System32\\cmd.exe",
                    "Command Prompt_EXE": "C:\\Windows\\System32\\cmd.exe",
                    "PowerShell_Dir": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                    "PowerShell_EXE": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                    "Python_Dir": "C:\\Users\\angry\\AppData\\Local\\Programs\\Python\\Python310",
                    "Python_EXE": "C:\\Users\\angry\\AppData\\Local\\Programs\\Python\\Python310\\python.exe",
                    "Java_Dir": "C:\\Program Files\\Java\\jdk-21.0.2",
                    "Java_EXE": "C:\\Program Files\\Java\\jdk-21.0.2\\bin\\java.exe",
                    "GO_Dir": "C:\\Users\\angry\\go",
                    "GO_EXE": "C:\\Users\\angry\\go\\bin\\gopls.exe",
                    "ADB_Dir": "C:\\Users\\angry\\AppData\\Local\\Android\\Sdk\\platform-tools",
                    "ADB_EXE": "C:\\Users\\angry\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe",
                    "Node.js_Dir": "C:\\Program Files\\nodejs",
                    "Node.js_EXE": "C:\\Program Files\\nodejs\\node.exe",
                    "NGROK_Dir": "C:\\Users\\angry\\ngrok",
                    "NGROK_EXE": "C:\\Users\\angry\\ngrok\\ngrok.exe",
                    "Cloudflared_Dir": "C:\\Users\\angry\\cloudflared",
                    "Cloudflared_EXE": "C:\\Users\\angry\\cloudflared\\cloudflared.exe"
                },

                // @ OS --Linux
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    },
                    "zsh": {
                        "path": "/bin/zsh"
                    },
                    "fish": {
                        "path": "/usr/bin/fish"
                    },
                    "python": {
                        "path": "/usr/bin/python3"
                    },
                    "java": {
                        "path": "/usr/bin/java"
                    },
                    "go": {
                        "path": "/usr/local/go/bin/go"
                    },
                    "adb": {
                        "path": "/usr/bin/adb"
                    },
                    "nodejs": {
                        "path": "/usr/bin/node"
                    },
                    "ngrok": {
                        "path": "/usr/local/bin/ngrok"
                    },
                    "cloudflared": {
                        "path": "/usr/local/bin/cloudflared"
                    }
                },

                "terminal.integrated.env.linux": {
                    "BASH_Dir": "/bin/bash",
                    "BASH_EXE": "/bin/bash",
                    "ZSH_Dir": "/bin/zsh",
                    "ZSH_EXE": "/bin/zsh",
                    "FISH_Dir": "/usr/bin/fish",
                    "FISH_EXE": "/usr/bin/fish",
                    "Python_Dir": "/usr/bin/python3",
                    "Python_EXE": "/usr/bin/python3",
                    "Java_Dir": "/usr/bin/java",
                    "Java_EXE": "/usr/bin/java",
                    "GO_Dir": "/usr/local/go/bin/go",
                    "GO_EXE": "/usr/local/go/bin/go",
                    "ADB_Dir": "/usr/bin/adb",
                    "ADB_EXE": "/usr/bin/adb",
                    "Node.js_Dir": "/usr/bin/node",
                    "Node.js_EXE": "/usr/bin/node",
                    "NGROK_Dir": "/usr/local/bin/ngrok",
                    "NGROK_EXE": "/usr/local/bin/ngrok",
                    "Cloudflared_Dir": "/usr/local/bin/cloudflared",
                    "Cloudflared_EXE": "/usr/local/bin/cloudflared"
                },
              // _cSpell \\
                "cSpell.caseSensitive": false,
                "cSpell.enabled": true,
                "cSpell.words": [
                    "AngrySatan",
                    "fx",
                    "lx",
                    ".conf",
                    ".journal",
                    "bitsnbobs",
                    "cardsmkimming",
                    "cyberforce",
                    "nikeh",
                    "pickpocketing",
                    "printstore",
                    "recyclingcenter",
                    "searchforcash",
                    "Tornsy",
                    "Yata"
                ],

              // _CMAKE \\
                // CMake-Tools
                "makefile.configureOnOpen": true,

              // _CPP TOOLS \\
                // Cpp-Tools & Extension-Packs
                "C_Cpp.clang_format_sortIncludes": true,
                "C_Cpp.copilotHover": "enabled",
                "C_Cpp.errorSquiggles": "enabled",

              // _FORMATTING & LINTING \\
                // Eslint
                "eslint.enable": true,
                "eslint.format.enable": true,

                // Prettier
                "prettier.trailingComma": "none",
                "prettier.tabWidth": 4,
                "prettier.printWidth": 10000,
                "prettier.htmlWhitespaceSensitivity": "strict",
                "prettier.enable": true,
                "prettier.useEditorConfig": true,

                // Auto-close-tag
                "auto-close-tag.enableAutoCloseTag": true,

                // Auto-rename-tag
                "auto-rename-tag.activationOnLanguage": [
                    "html"
                ],

                // Yaml
                "yaml.format.enable": true,
                "yaml.validate": true,
                "yaml.completion": true,
                "yaml.schemaStore.enable": true,

                // Trailing-spaces
                "trailing-spaces.trimOnSave": true,
                "trailing-spaces.includeEmptyLines": true,

              // _GIT HUB \\
                // Codespaces
                "github.codespaces.defaultExtensions": [
                    "GitHub.codespaces",
                    "GitHub.vscode-pull-request-github",
                    "Github.copilot"
                ],

              // GitHub-CoPilot
                "github.copilot.nextEditSuggestions.enabled": true,
                "terminal.integrated.sendKeybindingsToShell": true,
                "github.copilot.chat.followUps": "always",
                "github.copilot.nextEditSuggestions.fixes": true,
                "github.copilot.chat.codesearch.enabled": true,
                "github.copilot.chat.agent.thinkingTool": true,
                "github.copilot.chat.completionContext.typescript.mode": "on",
                "github.copilot.chat.languageContext.fix.typescript.enabled": true,
                "github.copilot.chat.languageContext.typescript.enabled": true,
                "github.copilot.enable": {
                    "*": true,
                    "plaintext": false,
                    "markdown": true,
                    "scminput": false,
                    "python": true,
                    "shellscript": false,
                    "ruby": true,
                    "rust": true,
                    "powershell": false,
                    "php": true,
                    "makefile": true,
                    "lua": true,
                    "less": true,
                    "jsonc": true,
                    "json": true,
                    "javascript": true,
                    "java": true,
                    "html": true,
                    "go": true,
                    "css": true,
                    "bat": true,
                    "diff": true,
                    "cpp": true,
                    "c": true,
                    "csharp": true,
                    "sql": true,
                    "typescript": true,
                    "xml": true,
                    "yaml": true
                },

              // _GIT TOOLS \\
                // Git-Graph
                "git-graph.commitDetailsView.autoCenter": true,
                "git-graph.commitDetailsView.fileView.fileTree.compactFolders": true,
                "git-graph.commitDetailsView.fileView.type": "File Tree",
                "git-graph.markdown": true,

              // _JAVA \\
                // Java Debugging
                "javascript.autoClosingTags": true,
                "javascript.format.enable": true,
                "javascript.inlayHints.parameterTypes.enabled": true,
                "javascript.preferences.organizeImports": {
                    "enabled": true,
                    "sortImports": true
                },
                "javascript.suggest.autoImports": true,
                "javascript.suggest.enabled": true,
                "javascript.suggest.completeJSDocs": true,
                "javascript.suggestionActions.enabled": true,

              // _JSON \\
                // Json-Schemas
                "json.format.enable": true,
                "json.validate.enable": true,

              // _MARKDOWN VIEWING / ABILITY \\
                // MarkDown-Lint
                "markdownlint.config": {
                    "no-inline-html": false,
                    "no-trailing-spaces": true,
                    "no-multiple-blanks": true,
                    "no-space-in-links": true
                },
                "markdown.validate.unusedLinkDefinitions.enabled": "hint",
                "markdown.editor.filePaste.enabled": "smart",
                "markdown.editor.filePaste.copyIntoWorkspace": "mediaFiles",

                // markdown-preview-github-styles
                "markdown.preview.linkify": true,
                "markdown.preview.breaks": true,
                "markdown.preview.scrollEditorWithPreview": true,
                "markdown.preview.scrollPreviewWithEditor": true,
                "markdown.preview.fontSize": 14,

                // markdown-checkbox"
                "markdown-checkboxes.enable": true,
                "markdown-checkboxes.label": true,

                // markdown-mermaid"
                "markdown-mermaid.maxTextSize": 30,
                "markdown-mermaid.darkModeTheme": "dark",
                "markdown-mermaid.lightModeTheme": "base",

                // "rogwilco.defaults-vscode-markdown"
                "markdown.extension.completion.enabled": true,
                "markdown.extension.math.enabled": true,
                "markdown.extension.toc.updateOnSave": true,
                "markdown.updateLinksOnFileMove.enabled": "always",
                "markdown.updateLinksOnFileMove.enableForDirectories": true,
                "markdown.validate.fileLinks.enabled": "warning",
                "markdown.links.openLocation": "beside",
                "markdown.extension.orderedList.autoRenumber": true,
                "markdown.extension.preview.autoShowPreviewToSide": true,
                "markdown.math.enabled": true,

              // _NODE.JS \\
                "npm.autoDetect": "on",

              // _PYTHON \\
                // Python-Envs
                "python-envs.defaultEnvManager": "ms-python.python:system",

                // Python-PyLance
                "python.analysis.logLevel": "Trace",
                "python.defaultInterpreterPath": "c:\\Program Files\\Python312\\python.exe",
                "editor.inlineSuggest.edits.showCollapsed": true,
                "bookmarks.sideBar.expanded": true,
                "git.enableSmartCommit": true,
                "editor.defaultFormatter": "GitHub.copilot",
                "bookmarks.saveBookmarksInProject": true,
                "bookmarks.useWorkaroundForFormatters": true,

              // _POWERSHELL \\
                "powershell.buttons.showRunButtons": true,
                "powershell.codeFormatting.autoCorrectAliases": true,

              // _SQL \\
                "sqlite.databaseExtensions": [
                    "db",
                    "db3",
                    "sdb",
                    "s3db",
                    "sqlite",
                    "sqlite3"
                ],
                "sqlite.logLevel": "DEBUG",
                "sqlite.sqlite3": "sqlite3",
                "sqltools.completionLanguages": [
                    "sql"
                ],

              // _TYPESCRIPT \\
                "typescript.suggest.enabled": true,
                "typescript.autoClosingTags": true,
                "typescript.format.enable": true,

              // _VS TOOLS \\
                "vsintellicode.java.completionsEnabled": true,
                "vsintellicode.typescript.completionsEnabled": true,
                "vsintellicode.python.completionsEnabled": true,
                "vsintellicode.sql.completionsEnabled": true,
                "vsintellicode.modify.editor.suggestSelection": "enabled",

              // _WSL \\
                "remote.WSL.debug": true,
                "remote.WSL.useShellEnvironment": true
            }
        }
    }
}
